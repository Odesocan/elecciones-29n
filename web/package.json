{
  "name": "odesocan-lee-los-programas",
  "private": true,
  "version": "0.2.0",
  "description": "Explorador de programas electorales (Elecciones Generales 29N) para la portada de odesocan.org · módulo Código de Divi",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build --config vite.divi.config.js && node scripts/empaquetar-divi.mjs",
    "prueba": "vite preview --config vite.divi.config.js --outDir ../divi --host 127.0.0.1 --port 4173",
    "publica": "vite preview --config vite.divi.config.js --outDir .. --host 127.0.0.1 --port 4181"
  },
  "dependencies": {
    "d3": "7.9.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "vite": "5.4.11"
  }
}
